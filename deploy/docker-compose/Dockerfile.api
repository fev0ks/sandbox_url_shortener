FROM golang:1.25-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -o /bin/api-http-stdlib ./cmd/api-http-stdlib

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=builder /bin/api-http-stdlib /usr/local/bin/api-http-stdlib
EXPOSE 8080
ENTRYPOINT ["api-http-stdlib"]
